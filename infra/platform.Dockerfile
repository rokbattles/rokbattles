# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
FROM node:26.12.1-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797 AS base
WORKDIR /app

FROM rust:1.99.1-alpine@sha256:dc578ff3ca62ef489ad9ae743f477b94d98739c3092d0023490ecd417c2eebea AS wasm-chef
WORKDIR /app
ENV CARGO_INCREMENTAL=0
RUN apk add --no-cache build-base openssl-dev pkgconfig libatomic libstdc++
RUN --mount=type=cache,id=rokbattles-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=rokbattles-cargo-git,target=/usr/local/cargo/git \
    cargo install cargo-chef --version 0.1.78 --locked
RUN rustup target add wasm32-unknown-unknown

FROM wasm-chef AS wasm-planner
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json && \
    sed -n 's/^wasm-bindgen = "=\([^"]*\)"$/\1/p' Cargo.toml > wasm-bindgen-version && \
    test -s wasm-bindgen-version

FROM wasm-chef AS wasm-deps
COPY --from=wasm-planner /app/wasm-bindgen-version ./wasm-bindgen-version
RUN --mount=type=cache,id=rokbattles-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=rokbattles-cargo-git,target=/usr/local/cargo/git \
    cargo install wasm-bindgen-cli --version "$(cat wasm-bindgen-version)" --locked
COPY --from=wasm-planner /app/recipe.json ./recipe.json
RUN --mount=type=cache,id=rokbattles-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=rokbattles-cargo-git,target=/usr/local/cargo/git \
    cargo chef cook --recipe-path recipe.json --profile size --locked \
        --target wasm32-unknown-unknown -p rokbattles-container \
        --no-default-features --features wasm-read && \
    cargo chef cook --recipe-path recipe.json --profile size --locked \
        --target wasm32-unknown-unknown -p rokbattles-webgpu-map-engine

FROM wasm-deps AS wasm
COPY --from=base /usr/local/bin/node /usr/local/bin/node
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates/common/rokbattles-container ./crates/common/rokbattles-container
COPY crates/common/rokbattles-container-simd ./crates/common/rokbattles-container-simd
COPY crates/common/rokbattles-webgpu-map-engine ./crates/common/rokbattles-webgpu-map-engine
COPY packages/site/scripts/build-container.sh packages/site/scripts/build-map-engine.sh ./packages/site/scripts/
RUN --mount=type=cache,id=rokbattles-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=rokbattles-cargo-git,target=/usr/local/cargo/git \
    export CONTAINER_WASM_OUT_DIR=/out/container MAP_ENGINE_WASM_OUT_DIR=/out/map-engine && \
    sh packages/site/scripts/build-container.sh && \
    sh packages/site/scripts/build-map-engine.sh

FROM base AS builder
RUN apk add --no-cache git libc6-compat
COPY --link pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY --link packages/site/package.json ./packages/site/package.json
RUN npm install --global corepack@0.36.0 && corepack enable pnpm
RUN --mount=type=cache,id=rokbattles-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile
COPY --link packages/site ./packages/site
COPY --from=wasm /out/container ./packages/site/src/autogenerated/container
COPY --from=wasm /out/map-engine ./packages/site/src/autogenerated/map-engine
COPY --link datasets ./datasets
RUN pnpm --filter=@rokbattles/site... run sync:legal
RUN pnpm --filter=@rokbattles/site... run generate:datasets
ARG API_URL
ENV API_URL=${API_URL}
RUN pnpm --filter=@rokbattles/site... build

FROM base AS runner
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/packages/site/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/packages/site/.next/static ./packages/site/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/packages/site/public ./packages/site/public
WORKDIR /app/packages/site
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
