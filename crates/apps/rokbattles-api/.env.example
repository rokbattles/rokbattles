# Copy this file to .env
BIND_ADDR=0.0.0.0:8001
RATE_LIMIT_MODE=local
MONGODB_URI=mongodb://localhost:27017/rokbattles
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/proxy/v1/auth/discord/callback

# Optional
SENTRY_DSN=
PK_TOKEN=
KDMT_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Set the public site origin to enable the private OIDC provider.
OIDC_ISSUER=
# Unpadded base64url encoding of a random 32-byte Ed25519 seed.
OIDC_SIGNING_SEED=
# Optional comma-separated base64url public keys for rollover.
OIDC_PUBLIC_KEYS=
