# Copy this file to .env
BIND_ADDR=0.0.0.0:8000
MONGODB_URI=mongodb://localhost:27017/rokbattles
RELAY_TOKEN=
CLAMAV_ENABLED=false
CLAMAV_ADDR=127.0.0.1:3310
CLAMAV_TIMEOUT_MS=15000
ZSTD_LEVEL=6
MAX_UPLOAD_BYTES=26214400

# Optional
SENTRY_DSN=

# Anonymous, insert-only desktop capture intake. OFF unless explicitly enabled.
# Requires TLS, streaming request bodies (proxy buffering OFF), no body/packet
# logging or tracing, and edge rate/connection limits. Never supply RELAY_TOKEN
# to desktop clients. Context/player IDs do not authenticate ownership.
# Default admission: 4 global sessions, 2 per socket peer; no forwarded headers
# are trusted. Behind a reverse proxy, all clients may share its peer quota.
# Reserve >=1 GiB plus normal ingress memory before enabling; load-test first.
# A transport failure can follow partial mail storage and cannot resume cipher
# state. The client must wait for a fresh game connection after capture loss.
DESKTOP_CAPTURE_ENABLED=false
